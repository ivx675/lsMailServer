  "SmtpRelay": {
    "HostName": "mail.host.com",
    "MaxOutboundConnections": 20,
    "MaxConnectionsPerDomain": 2,
    "MaxSessionTimeout": "00:05:00",
    "UseTlsIfPossible": false,
