{
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:5001",
        "Certificate": {
          "Path": "Data/Certificates/kestrel.pfx",
          "Password": "1234"
        }
      }
    }
  },
  "General": {
    "DnsServers": [
      "1.1.1.1",
      "8.8.8.8"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AdminAuth": {
    "Username": "admin",
    "Password": "1234"
