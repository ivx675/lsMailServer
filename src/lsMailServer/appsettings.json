    "EnableSenderValidation": true,
    "EnableDkimValidation": true,
    "Enabled": true,
    "MaxConnections": 100,
    "MaxConnectionsPerIP": 10,
    "SessionIdleTimeout": 300,
    "ListenEndpoints": [
      {
        "HostName": "mail.host.com",
        "IP": "0.0.0.0",
        "Port": 25,
        "TlsMode": "Explicit",
        "CertFileName": "test.pfx",
        "CertPassword": "1234"
      },
      {
        "HostName": "mail.host.com",
        "IP": "0.0.0.0",
        "Port": 465,
        "TlsMode": "Implicit",
        "CertFileName": "test.pfx",
        "CertPassword": "1234"
      }
    ]
  },
  "Pop3Server": {
    "Enabled": true,
    "MaxConnections": 100,
    "MaxConnectionsPerIP": 10,
    "SessionIdleTimeout": 300,
    "ListenEndpoints": [
      {
        "HostName": "mail.host.com",
        "IP": "0.0.0.0",
        "Port": 110,
        "TlsMode": "Explicit",
        "CertFileName": "test.pfx",
